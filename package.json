{
  "name": "@relyper/sp-auth",
  "version": "0.5.2",
  "description": "Relyper identity for a service provider: an OIDC client (Authorization Code + PKCE) with a Fastify adapter and session cookies, plus the header-based variant for gateway deployments.",
  "license": "MIT",
  "author": "Jonas Esser",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "relyper",
    "identity",
    "authentication",
    "authorization",
    "service-provider",
    "fastify",
    "rbac",
    "oidc",
    "openid-connect",
    "oauth2",
    "pkce",
    "sso",
    "coins",
    "billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasesser/relyper-sp-auth.git"
  },
  "bugs": {
    "url": "https://github.com/jonasesser/relyper-sp-auth/issues"
  },
  "homepage": "https://github.com/jonasesser/relyper-sp-auth#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "import": "./dist/oidc.js"
    },
    "./oidc/fastify": {
      "types": "./dist/oidc-fastify.d.ts",
      "import": "./dist/oidc-fastify.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./coins": {
      "types": "./dist/coins.d.ts",
      "import": "./dist/coins.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.10"
  },
  "peerDependencies": {
    "fastify": ">=5"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "fastify": "^5.12.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
